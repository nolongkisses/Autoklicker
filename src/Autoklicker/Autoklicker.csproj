<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Autoklicker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Autoklicker</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Kompakter Autoklicker für Windows</Description>
    <Authors>Autoklicker</Authors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Autoklicker.ico" />
    <InternalsVisibleTo Include="Autoklicker.Tests" />
  </ItemGroup>
</Project>
