<Window x:Class="Autoklicker.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Autoklicker" Width="340" Height="300" ResizeMode="CanMinimize"
 WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False" Background="{StaticResource SurfaceBackground}" BorderThickness="0"
 Foreground="#F1F1F1" FontFamily="Segoe UI" FontSize="12"
 Icon="Assets/Autoklicker.ico" UseLayoutRounding="True" SnapsToDevicePixels="True"
 PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown">
 <shell:WindowChrome.WindowChrome>
  <!-- Keep a DWM frame so Windows clips and antialiases the actual HWND.
       A WPF region or layered alpha surface defeats native corner rounding. -->
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Border BorderThickness="0" Padding="1" Background="{StaticResource SurfaceBackground}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Grid Background="Transparent">
    <Border Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="2" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="MinimizeButton" Width="30" Height="24" Margin="1,0" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsTabStop="False" Click="Minimize_Click" ToolTip="In den Infobereich minimieren" AutomationProperties.Name="Minimieren">
       <Path Data="M 0,0 L 10,0" Stroke="#949494" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Button>
      <Button x:Name="CloseButton" Width="30" Height="24" Margin="1,0" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsTabStop="False" Click="Close_Click" ToolTip="Schließen" AutomationProperties.Name="Schließen">
       <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#949494" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Button>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="1" Margin="22,0,22,12">
    <Grid.RowDefinitions>
     <RowDefinition Height="40" /><RowDefinition Height="34" /><RowDefinition Height="43" /><RowDefinition Height="51" /><RowDefinition Height="38" /><RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Autoklicker" FontFamily="Bahnschrift, Segoe UI" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,0,0" />
    <Grid Grid.Row="1">
     <TextBlock Text="Klicks pro Sekunde" Foreground="#A5A5A5" VerticalAlignment="Center" />
     <TextBox x:Name="RateBox" Text="10" Width="56" Height="32" HorizontalAlignment="Right" TextAlignment="Center" FontWeight="Normal" FontFamily="Segoe UI" FontSize="14"
      AutomationProperties.Name="Klicks pro Sekunde" AutomationProperties.AutomationId="RateBox"
      TextChanged="RateBox_TextChanged" LostKeyboardFocus="RateBox_LostKeyboardFocus" PreviewKeyDown="RateBox_PreviewKeyDown" />
    </Grid>
    <Grid Grid.Row="2" Margin="0,5,0,0">
     <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="16" /></Grid.RowDefinitions>
     <Slider x:Name="RateSlider" Minimum="1" Maximum="100" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" FocusVisualStyle="{x:Null}"
      AutomationProperties.Name="Klickrate" AutomationProperties.AutomationId="RateSlider" ValueChanged="RateSlider_ValueChanged">
      <Slider.Template><ControlTemplate TargetType="Slider">
       <Grid Background="Transparent" Margin="0,2">
        <Border Height="3" Margin="7,0" Background="#292929" CornerRadius="2" />
        <Track x:Name="PART_Track">
         <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#B5B5B5" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
         <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F1F1F1" Stroke="#F1F1F1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
         <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
       </Grid>
       <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Slider.Template>
     </Slider>
     <Grid Grid.Row="1" Margin="4,0" TextBlock.FontSize="10" TextBlock.Foreground="#949494" IsHitTestVisible="False">
      <TextBlock Text="1" HorizontalAlignment="Left" Foreground="{StaticResource Muted}" />
      <TextBlock Text="25" HorizontalAlignment="Left" Margin="63,0,0,0" Foreground="{StaticResource Muted}" />
      <TextBlock Text="50" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
      <TextBlock Text="75" HorizontalAlignment="Right" Margin="0,0,64,0" Foreground="{StaticResource Muted}" />
      <TextBlock Text="100" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
     </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="0,3,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Hotkey" Foreground="#D7D7D7" />
      <TextBlock Text="Start / Stopp" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
     </StackPanel>
     <Button x:Name="HotkeyButton" Grid.Column="1" FontSize="12" Padding="8,4" Click="Hotkey_Click"
      AutomationProperties.Name="Hotkey ändern" AutomationProperties.AutomationId="HotkeyButton" ToolTip="Anklicken und eine Taste oder Tastenkombination drücken. Esc bricht ab.">
      <TextBlock x:Name="HotkeyLabel" Text="F6" TextTrimming="CharacterEllipsis" MaxWidth="130" />
     </Button>
    </Grid>
    <Button x:Name="ToggleButton" Grid.Row="4" Click="Toggle_Click" Background="#F1F1F1" Foreground="#0D0D0D" BorderBrush="#F1F1F1" BorderThickness="0" FontWeight="SemiBold" FontSize="12" AutomationProperties.AutomationId="ToggleButton">
     <StackPanel Orientation="Horizontal">
      <Path x:Name="ToggleIcon" Data="M 0,0 L 0,10 L 8,5 Z" Fill="{Binding Foreground, ElementName=ToggleButton}" Width="9" Height="10" Stretch="Uniform" Margin="0,0,9,0" />
      <TextBlock x:Name="ToggleLabel" Text="Starten" Foreground="{Binding Foreground, ElementName=ToggleButton}" />
     </StackPanel>
    </Button>
    <Grid Grid.Row="5" Margin="0,11,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#717171" VerticalAlignment="Top" Margin="0,5,0,0" />
     <TextBlock x:Name="StatusText" Grid.Column="1" Text="Bereit · Linksklick an Mausposition" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
