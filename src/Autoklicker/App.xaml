<Application x:Class="Autoklicker.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <!-- NoxVault's surface hierarchy and control shapes, in neutral black/gray. -->
  <SolidColorBrush x:Key="Muted" Color="#949494" />
  <SolidColorBrush x:Key="SurfaceBackground" Color="#0D0D0D" />
  <SolidColorBrush x:Key="PanelBackground" Color="#171717" />
  <SolidColorBrush x:Key="Hairline" Color="#292929" />
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1" /></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#171717" />
   <Setter Property="Foreground" Value="#F1F1F1" />
   <Setter Property="BorderBrush" Value="#292929" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="12,8" />
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid SnapsToDevicePixels="False" RenderOptions.EdgeMode="Unspecified">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
      <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="6" IsHitTestVisible="False" />
      <Border x:Name="Pressed" Background="Black" Opacity="0" CornerRadius="6" IsHitTestVisible="False" />
      <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" />
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
       <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pressed" Property="Opacity" Value="0.16" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#A0A0A0" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#171717" /><Setter Property="Foreground" Value="#F1F1F1" />
   <Setter Property="CaretBrush" Value="#F1F1F1" /><Setter Property="SelectionBrush" Value="#515151" />
   <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Padding" Value="6,3" /><Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
     <Decorator x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#202020" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#242424" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#171717" /><Setter Property="Foreground" Value="#D7D7D7" /><Setter Property="BorderBrush" Value="#292929" />
   <Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="11" /><Setter Property="MaxWidth" Value="280" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
